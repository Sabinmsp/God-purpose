# Copy to .env.local for local development. Never commit real values.
# None of these are NEXT_PUBLIC_ — they are only ever read on the server.

# Postgres connection string. On Vercel + Supabase use the pooled
# "Transaction" connection string (port 6543). The Supabase Marketplace
# integration sets POSTGRES_URL instead, which is also accepted.
DATABASE_URL=postgres://user:password@localhost:5432/fourwins_dev

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: extra origins allowed to make state-changing API calls
# (comma separated), e.g. a custom domain. Same-host requests always work.
# APP_ORIGIN=https://fourwins.example.com

# Optional: PixelLab API key for the asset generation adapter (server only).
# PIXELLAB_API_KEY=

# The access password is NOT configured here. Set it with:
#   npm run setup            (hidden prompt; stores only a scrypt hash in the DB)
#   npm run setup -- --pin   (also sets a short unlock PIN)
