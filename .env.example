# Copy to .env.local for local development. Never commit real values.
# None of these are NEXT_PUBLIC_ — they are only ever read on the server.

# Postgres connection string. On Vercel + Supabase use the pooled
# "Transaction" connection string (port 6543). The Supabase Marketplace
# integration sets POSTGRES_URL instead, which is also accepted.
DATABASE_URL=postgres://user:password@localhost:5432/fourwins_dev

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: extra origins allowed to make state-changing API calls
# (comma separated), e.g. a custom domain. Same-host requests always work.
# APP_ORIGIN=https://fourwins.example.com

# Optional: PixelLab API key for the asset generation adapter (server only).
# PIXELLAB_API_KEY=

# The access password is NOT configured here. Set it with:
#   npm run setup            (hidden prompt; stores only a scrypt hash in the DB)
#   npm run setup -- --pin   (also sets a short unlock PIN)

# ── Accounts (optional) ───────────────────────────────────────────────────
# Anyone can create an account from the login page by default.
# SIGNUPS=closed                    # turn new accounts off (existing players can still log in)
# SIGNUP_CODE=                      # require this invite code to create an account

# ── Four Wins AI companion (optional; server-only) ─────────────────────────
# Without a key the companion shows a "sleeping" notice and everything else
# keeps working. Keys are read only on the server and never sent to browsers.
#
# Option A — free open-source models (no card needed for the free tiers):
# AI_PROVIDER=groq                  # groq | openrouter | ollama | openai-compatible
# AI_API_KEY=                       # free key from console.groq.com or openrouter.ai (ollama needs none)
# AI_MODEL=                         # optional; defaults: groq openai/gpt-oss-120b, openrouter openrouter/free
#                                   # ollama: required, the model you pulled (runs on your own computer only)
# AI_BASE_URL=                      # only for openai-compatible, or to point a preset somewhere else
#
# Optional backup, tried automatically when the main AI is busy or down:
# AI_FALLBACK=openrouter            # any provider name above
# AI_FALLBACK_API_KEY=              # the backup's own key (OPENROUTER_API_KEY also works)
# AI_FALLBACK_MODEL=                # optional; same defaults as above
#
# Option B — Claude (paid, pay-as-you-go):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5          # any Claude model id
#                                   # claude-haiku-5-5 costs a small fraction per message if money is tight
# AI_EFFORT=medium                  # low | medium | high | xhigh | max

# ── Reminders (optional; they work with no configuration) ──────────────────
# Push keys are derived from AUTH_SECRET, so there is nothing to generate.
# Set CRON_SECRET in Vercel to make the scheduler endpoint refuse any caller
# that does not present it (Vercel Cron sends it automatically).
# CRON_SECRET=
# Contact URL or mailto: sent to push services. Defaults to the site's URL.
# VAPID_SUBJECT=
